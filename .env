# Note: Description of the different variables can be found here: https://swiyu-admin-ch.github.io/cookbooks/onboarding-generic-issuer/#set-the-environment-variables

# Issuer Management variables
EXTERNAL_URL="https:<url of your own swiyu-issuer-service>" #This gets described in Step 3.1 of the README
SPRING_APPLICATION_NAME="<custom name of the application>" #You can choose whatever you want

#This is the same key twice. It should have been generated by the script and be saved in ./setup-script/.didtoolbox/assert-key-01
STATUS_LIST_KEY="
-----BEGIN EC PRIVATE KEY-----
<private key of the file 'assert-key-01'>
-----END EC PRIVATE KEY-----
"
SDJWT_KEY="
-----BEGIN EC PRIVATE KEY-----
<private key of the file 'assert-key-01'>
-----END EC PRIVATE KEY-----
"

# Same value you had to input in the script. Can be found at https://portal.trust-infra.swiyu-int.admin.ch/ui/organizations
SWIYU_PARTNER_ID="<Your SWIYU_PARTNER_ID>"

# This is the information you saved at the start of the walkthrough: https://selfservice.api.admin.ch/api-selfservice/applications
SWIYU_STATUS_REGISTRY_ACCESS_TOKEN="<Your SWIYU_STATUS_REGISTRY_ACCESS_TOKEN>"
SWIYU_STATUS_REGISTRY_BOOTSTRAP_REFRESH_TOKEN="<Your SWIYU_STATUS_REGISTRY_BOOTSTRAP_REFRESH_TOKEN>"
SWIYU_STATUS_REGISTRY_CUSTOMER_KEY="<Your SWIYU_STATUS_REGISTRY_CUSTOMER_KEY>"
SWIYU_STATUS_REGISTRY_CUSTOMER_SECRET="<Your SWIYU_STATUS_REGISTRY_CUSTOMER_SECRET>"

###############################################
# Environment-specific values
###############################################

# Token endpoint for your environment (INT, PRD, etc.)
# Example for INT:
# https://keymanager-int.api.admin.ch/keycloak/realms/APIGW/protocol/openid-connect/token
SWIYU_STATUS_REGISTRY_TOKEN_URL="https://keymanager-prd.api.admin.ch/keycloak/realms/APIGW/protocol/openid-connect/token"
# Status Registry API base URL
# Example for INT:
# https://status-reg-api.trust-infra.swiyu-int.admin.ch
SWIYU_STATUS_REGISTRY_API_URL="https://status-reg-api.trust-infra.swiyu-int.admin.ch"

# Issuer OID4VCI variables
ISSUER_ID="<Your ISSUER_ID>" #e.g did:tdw:QmejrSkusQgeM6FfA23L6NPoLy3N8aaiV6X5Ysvb47WSj8:identifier-reg-r.trust-infra.swiyu.admin.ch:api:v1:did:ff8eb859-6996-4e51-a976-be1ca584c124
OID4VCI_ISSUER_ID="<Your ISSUER_ID>" #e.g did:tdw:QmejrSkusQgeM6FfA23L6NPoLy3N8aaiV6X5Ysvb47WSj8:identifier-reg-r.trust-infra.swiyu.admin.ch:api:v1:did:ff8eb859-6996-4e51-a976-be1ca584c124
DID_SDJWT_VERIFICATION_METHOD="<Your ISSUER_ID>#assert-key-01" #e.g did:tdw:QmejrSkusQgeM6FfA23L6NPoLy3N8aaiV6X5Ysvb47WSj8:identifier-reg-r.trust-infra.swiyu.admin.ch:api:v1:did:ff8eb859-6996-4e51-a976-be1ca584c124#assert-key-01
DID_STATUS_LIST_VERIFICATION_METHOD="<Your ISSUER_DID>#assert-key-01"